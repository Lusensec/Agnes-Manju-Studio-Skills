# Agnes AI API Key (get from https://platform.agnes-ai.cn)
AGNESAI_API_KEY=your-api-key-here

# API platform base URL (OpenAI-style /v1 root).
# Domestic: https://api.agnes-ai.cn/v1   (default)
# International: https://apihub.agnes-ai.com/v1
#AGNESAI_BASE_URL=https://api.agnes-ai.cn/v1

# Optional: parallel video generation with multiple keys/platforms.
# Comma-separated; gen-video.py starts one worker per key (each keeps its
# own 65s submit rhythm). An entry may carry a per-key platform override
# with @baseURL, so domestic + international keys can run in parallel:
#   AGNESAI_API_KEYS=sk-domestic,sk-intl@https://apihub.agnes-ai.com/v1
# Without @, the key uses AGNESAI_BASE_URL.
#AGNESAI_API_KEYS=key1,key2@https://apihub.agnes-ai.com/v1

# Project root directory (default: ~/manju-studio/projects; legacy COMIC_STUDIO_ROOT still works)
# Must be an absolute path.
#MANJU_STUDIO_ROOT=/home/user/manju-studio/projects

# ---- Optional: audio-reference video generation (mouth sync) ----
# When set, gen-video.py uploads the project's TTS lines (videos/audio/line-*.mp3,
# produced by gen-tts.py) to this PUBLIC GitHub repo and passes them to the video
# model as `audios` references, so speaking mouths animate roughly in sync with
# the line audio. Without it, videos are generated image-only.
#AGNES_TTS_GITHUB_REPO=owner/repo
#AGNES_TTS_REPO_BRANCH=main

# ---- Optional: git network tuning for the TTS upload step ----
#AGNES_GIT_PROXY=http://127.0.0.1:7897
#AGNES_GIT_SSL=openssl
